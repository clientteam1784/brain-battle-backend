  "components": {
    "schemas": {
      "AnswerResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "submittedAnswer": {
            "type": "string",
            "title": "Submittedanswer"
          },
          "correct": {
            "type": "boolean",
            "title": "Correct"
          },
          "submitCount": {
            "type": "integer",
            "title": "Submitcount"
          },
          "modifyCount": {
            "type": "integer",
            "title": "Modifycount"
          },
          "wrongCount": {
            "type": "integer",
            "title": "Wrongcount"
          }
        },
        "type": "object",
        "required": [
          "id",
          "submittedAnswer",
          "correct",
          "submitCount",
          "modifyCount",
          "wrongCount"
        ],
        "title": "AnswerResponse"
      },
      "AnswerStatus": {
        "type": "string",
        "enum": [
          "UNSUBMITTED",
          "WRONG",
          "CORRECT",
          "EXHAUSTED"
        ],
        "title": "AnswerStatus"
      },
      "AnswerSubmitRequest": {
        "properties": {
          "submittedAnswer": {
            "type": "string",
            "title": "Submittedanswer"
          }
        },
        "type": "object",
        "required": [
          "submittedAnswer"
        ],
        "title": "AnswerSubmitRequest"
      },
      "AuthTokenResponse": {
        "properties": {
          "accessToken": {
            "type": "string",
            "title": "Accesstoken"
          },
          "tokenType": {
            "type": "string",
            "title": "Tokentype",
            "default": "bearer"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "expiresIn": {
            "type": "integer",
            "title": "Expiresin"
          },
          "studentId": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Studentid"
          },
          "teamId": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Teamid"
          }
        },
        "type": "object",
        "required": [
          "accessToken",
          "role",
          "expiresIn"
        ],
        "title": "AuthTokenResponse"
      },
      "BatchAnswerItem": {
        "properties": {
          "questionId": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Questionid"
          },
          "submittedAnswer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Submittedanswer"
          }
        },
        "type": "object",
        "required": [
          "questionId"
        ],
        "title": "BatchAnswerItem"
      },
      "BatchAnswerSubmitRequest": {
        "properties": {
          "answers": {
            "items": {
              "$ref": "#/components/schemas/BatchAnswerItem"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Answers"
          }
        },
        "type": "object",
        "title": "BatchAnswerSubmitRequest"
      },
      "BatchAnswerSubmitResponse": {
        "properties": {
          "teamId": {
            "type": "integer",
            "title": "Teamid"
          },
          "submissionRound": {
            "type": "integer",
            "title": "Submissionround"
          },
          "correctCount": {
            "type": "integer",
            "title": "Correctcount"
          },
          "totalQuestions": {
            "type": "integer",
            "title": "Totalquestions"
          },
          "finished": {
            "type": "boolean",
            "title": "Finished"
          },
          "questions": {
            "items": {
              "$ref": "#/components/schemas/QuestionProgressResponse"
            },
            "type": "array",
            "title": "Questions"
          },
          "rotationQuestionIds": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Rotationquestionids"
          },
          "nextQuestionId": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nextquestionid"
          },
          "gradedCount": {
            "type": "integer",
            "title": "Gradedcount"
          }
        },
        "type": "object",
        "required": [
          "teamId",
          "submissionRound",
          "correctCount",
          "totalQuestions",
          "finished",
          "questions",
          "rotationQuestionIds",
          "nextQuestionId",
          "gradedCount"
        ],
        "title": "BatchAnswerSubmitResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "QuestionProgressResponse": {
        "properties": {
          "questionId": {
            "type": "integer",
            "title": "Questionid"
          },
          "questionNumber": {
            "type": "integer",
            "title": "Questionnumber"
          },
          "status": {
            "$ref": "#/components/schemas/AnswerStatus"
          },
          "submittedAnswer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Submittedanswer"
          },
          "submitCount": {
            "type": "integer",
            "title": "Submitcount"
          },
          "wrongCount": {
            "type": "integer",
            "title": "Wrongcount"
          },
          "maxSubmitCount": {
            "type": "integer",
            "title": "Maxsubmitcount"
          },
          "remainingAttempts": {
            "type": "integer",
            "title": "Remainingattempts"
          },
          "locked": {
            "type": "boolean",
            "title": "Locked"
          }
        },
        "type": "object",
        "required": [
          "questionId",
          "questionNumber",
          "status",
          "submittedAnswer",
          "submitCount",
          "wrongCount",
          "maxSubmitCount",
          "remainingAttempts",
          "locked"
        ],
        "title": "QuestionProgressResponse"
      },
      "QuestionRequest": {
        "properties": {
          "questionNumber": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Questionnumber"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "maxSubmitCount": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Maxsubmitcount"
          }
        },
        "type": "object",
        "required": [
          "questionNumber",
          "answer",
          "maxSubmitCount"
        ],
        "title": "QuestionRequest"
      },
      "QuestionResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "questionNumber": {
            "type": "integer",
            "title": "Questionnumber"
          },
          "maxSubmitCount": {
            "type": "integer",
            "title": "Maxsubmitcount"
          }
        },
        "type": "object",
        "required": [
          "id",
          "questionNumber",
          "maxSubmitCount"
        ],
        "title": "QuestionResponse"
      },
      "RankingResponse": {
        "properties": {
          "rank": {
            "type": "integer",
            "title": "Rank"
          },
          "teamName": {
            "type": "string",
            "title": "Teamname"
          },
          "currentCount": {
            "type": "integer",
            "title": "Currentcount"
          },
          "finished": {
            "type": "boolean",
            "title": "Finished"
          },
          "finishedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finishedat"
          }
