{
  "openapi": "3.1.0",
  "info": {
    "title": "Brain Battle API",
    "version": "0.1.0"
  },
  "paths": {
    "/questions": {
      "get": {
        "summary": "Get Questions",
        "operationId": "get_questions_questions_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/QuestionResponse"
                  },
                  "type": "array",
                  "title": "Response Get Questions Questions Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create Question",
        "operationId": "create_question_questions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuestionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuestionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/questions/{question_id}": {
      "patch": {
        "summary": "Update Question",
        "operationId": "update_question_questions__question_id__patch",
        "parameters": [
          {
            "name": "question_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Question Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuestionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuestionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete Question",
        "operationId": "delete_question_questions__question_id__delete",
        "parameters": [
          {
            "name": "question_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Question Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/rooms": {
      "post": {
        "summary": "Create Room",
        "operationId": "create_room_rooms_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoomResponse"
                }
              }
            }
          }
        }
      }
    },
    "/rooms/{room_id}/start": {
      "patch": {
        "summary": "Start Room",
        "operationId": "start_room_rooms__room_id__start_patch",
        "parameters": [
          {
            "name": "room_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Room Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoomResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/rooms/{pin}/teams": {
      "post": {
        "summary": "Join Room",
        "operationId": "join_room_rooms__pin__teams_post",
        "parameters": [
          {
            "name": "pin",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Pin"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TeamJoinRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeamResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/teams/{team_id}/students": {
      "post": {
        "summary": "Join Team",
        "operationId": "join_team_teams__team_id__students_post",
        "parameters": [
          {
            "name": "team_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Team Id"
            }
          },
          {
            "name": "studentNumber",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Studentnumber"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudentResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/teams/{team_id}/answers/{question_id}": {
      "post": {
        "summary": "Submit Answer",
        "operationId": "submit_answer_teams__team_id__answers__question_id__post",
        "parameters": [
          {
            "name": "team_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Team Id"
            }
          },
          {
            "name": "question_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Question Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnswerSubmitRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnswerResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/rooms/{room_id}/ranking": {
      "get": {
        "summary": "Get Ranking",
        "operationId": "get_ranking_rooms__room_id__ranking_get",
        "parameters": [
          {
            "name": "room_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Room Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RankingResponse"
                  },
                  "title": "Response Get Ranking Rooms  Room Id  Ranking Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnswerResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "submittedAnswer": {
            "type": "string",
            "title": "Submittedanswer"
          },
          "correct": {
            "type": "boolean",
            "title": "Correct"
          },
          "submitCount": {
            "type": "integer",
            "title": "Submitcount"
          },
          "modifyCount": {
            "type": "integer",
            "title": "Modifycount"
          }
        },
        "type": "object",
        "required": [
          "id",
          "submittedAnswer",
          "correct",
          "submitCount",
          "modifyCount"
        ],
        "title": "AnswerResponse"
      },
      "AnswerSubmitRequest": {
        "properties": {
          "submittedAnswer": {
            "type": "string",
            "title": "Submittedanswer"
          }
        },
        "type": "object",
        "required": [
          "submittedAnswer"
        ],
        "title": "AnswerSubmitRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "QuestionRequest": {
        "properties": {
          "questionNumber": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Questionnumber"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "maxSubmitCount": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Maxsubmitcount"
          }
        },
        "type": "object",
        "required": [
          "questionNumber",
          "answer",
          "maxSubmitCount"
        ],
        "title": "QuestionRequest"
      },
      "QuestionResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "questionNumber": {
            "type": "integer",
            "title": "Questionnumber"
          },
          "maxSubmitCount": {
            "type": "integer",
            "title": "Maxsubmitcount"
          }
        },
        "type": "object",
        "required": [
          "id",
          "questionNumber",
          "maxSubmitCount"
        ],
        "title": "QuestionResponse"
      },
      "RankingResponse": {
        "properties": {
          "rank": {
            "type": "integer",
            "title": "Rank"
          },
          "teamName": {
            "type": "string",
            "title": "Teamname"
          },
          "currentCount": {
            "type": "integer",
            "title": "Currentcount"
          },
          "finished": {
            "type": "boolean",
            "title": "Finished"
          },
          "finishedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finishedat"
          }
        },
        "type": "object",
        "required": [
          "rank",
          "teamName",
          "currentCount",
          "finished",
          "finishedAt"
        ],
        "title": "RankingResponse"
      },
      "RoomResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "pin": {
            "type": "string",
            "title": "Pin"
          },
          "started": {
            "type": "boolean",
            "title": "Started"
          }
        },
        "type": "object",
        "required": [
          "id",
          "pin",
          "started"
        ],
        "title": "RoomResponse"
      },
      "StudentResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "studentNumber": {
            "type": "string",
            "title": "Studentnumber"
          },
          "teamId": {
            "type": "integer",
            "title": "Teamid"
          }
        },
        "type": "object",
        "required": [
          "id",
          "studentNumber",
          "teamId"
        ],
        "title": "StudentResponse"
      },
      "TeamJoinRequest": {
        "properties": {
          "teamName": {
            "type": "string",
            "title": "Teamname"
          }
        },
        "type": "object",
        "required": [
          "teamName"
        ],
        "title": "TeamJoinRequest"
      },
      "TeamResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "currentCount": {
            "type": "integer",
            "title": "Currentcount"
          },
          "finished": {
            "type": "boolean",
            "title": "Finished"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "currentCount",
          "finished"
        ],
        "title": "TeamResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
